# .env file for glass_effect project
# All configurable constants for the project

# Face detection
FACE_CASCADE_PATH=haarcascade_frontalface_default.xml
FACE_SCALE_FACTOR=0.5
FACE_DETECT_SCALE=1.1
FACE_DETECT_MIN_NEIGHBORS=5
FACE_DETECT_WEIGHT_THRESHOLD=5

# Glass effect
GRID_SIZE=5
FEATHER_EDGES=True

# Distortion
DISTORTION_STRENGTH_MIN=5
DISTORTION_STRENGTH_MAX=12
NOISE_FACTOR=2

# Frosted material
FROSTED_KERNEL_CHOICES=15,27,31

# Clear material
CLEAR_BLUR_KERNEL=7

# Glossy material
GLOSSY_BLUR_KERNEL=9
HIGHLIGHT_BLUR_KERNEL=15
HIGHLIGHT_LINE_COLOR=255,255,255
HIGHLIGHT_LINE_THICKNESS=1
HIGHLIGHT_LINE_POSITION=0.5
GLOSSY_WEIGHT=0.85
HIGHLIGHT_WEIGHT=0.15

# Output
OUTPUT_PATH=output/output_google.jpg
INPUT_IMAGE=input/input.jpg
